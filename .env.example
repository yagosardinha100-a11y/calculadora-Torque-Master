# URL pública do app (opcional; usada pelo server local)
APP_URL=

# ---------------------------------------------------------------------------
# Firebase (client) — aponte para o SEU projeto Firebase.
# Copie este arquivo para `.env.local` e preencha com os valores do seu app web
# em: Firebase Console → Configurações do projeto → Seus apps → SDK config.
#
# Estes valores NÃO são segredos (são identificadores do app web). A segurança
# de verdade é feita pelas regras do Firestore (firestore.rules).
#
# Se nenhuma variável for definida, o app usa firebase-applet-config.json.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Opcional: id de um banco Firestore não-padrão (deixe vazio para "(default)")
VITE_FIREBASE_DATABASE_ID=
