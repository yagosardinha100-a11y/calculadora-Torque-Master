rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Login UX allowlist is mirrored here for data access.
    // Prefer promoting admins via /admins/{uid} created by a trusted operator.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isAllowlistedEmail() {
      return request.auth.token.email in [
        'odn1mecanicadept@gmail.com',
        'yago.sardinha100@gmail.com',
        'joubertribeir@gmail.com'
      ];
    }

    function isAdminDoc() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (isAllowlistedEmail() || isAdminDoc());
    }

    // Only existing admins can READ admin docs.
    // Writes are denied from the client — promote via Console / trusted tooling.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /turmas/{docId} {
      allow read, write: if isAdmin();
    }

    match /collaborators/{docId} {
      allow read, write: if isAdmin();
    }

    match /events/{docId} {
      allow read, write: if isAdmin();
    }

    match /vacations/{docId} {
      allow read, write: if isAdmin();
    }

    match /trainings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
